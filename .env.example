# Next 14.2.35 ships SWC 14.2.33; skip the broken lockfile auto-patch.
NEXT_IGNORE_INCORRECT_LOCKFILE=1

MONGO_URI=mongodb://localhost/proposal
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_RPC_URL=https://polygon-bor-rpc.publicnode.com
NEXT_PUBLIC_API_BASE_URL=/api/
NEXT_PUBLIC_NETWORK_CHAIN_ID=137
NEXT_PUBLIC_NETWORK_CHAIN_NAME=polygon-mainnet

# WalletConnect v2 Cloud project id (https://cloud.reown.com). Required for WalletConnect.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional. Used as a public RPC fallback.
NEXT_PUBLIC_INFURA_PROJECT_ID=

# Optional. Only needed if you call Etherscan/Polygonscan helpers.
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=

# Polygon contract and treasury addresses. Defaults match mainnet if omitted.
NEXT_PUBLIC_HODLDAO_ADDRESS=0xa8b0249eB35cA066f8E0f35DFbC28c54Dc4bDA37
NEXT_PUBLIC_HOCDAO_ADDRESS=0xE126F743E49d58703bc859A200b7de8d4C60253c
NEXT_PUBLIC_HODL_ADDRESS=0xD1777722a20CF1A71f0204E066011AAD040eC39d
NEXT_PUBLIC_HOC_ADDRESS=0x266D6aE2C9957cf4fC57558b3DdB67582DF9baaF
NEXT_PUBLIC_FTO_ADDRESS=0x8cEb15BA083fdCeC6c94F21De4d9C05680eF2774
NEXT_PUBLIC_CTO_MINT_SPLITTER_ADDRESS=0x4f42fAe5E87674810980E6d6dfb48985637D925e
NEXT_PUBLIC_HODL_FOUNDERS_SPLITTER_ADDRESS=0x55cc4E0E9251b4d04a20dfa54d29C4fef2803fA6
NEXT_PUBLIC_HODL_TEAM_SPLITTER_ADDRESS=0x72C75F30457F38E4e811eF86fedAB1800a064AB9
NEXT_PUBLIC_HODL_EQUITY_PARTNERS_SPLITTER_ADDRESS=0xC144aAbc2cB9E7A65838D087B70F5ffE419527e7
NEXT_PUBLIC_FOLIO_MONI_WALLET_ADDRESS=0xE8E874Bfa8cc64b9e1656777A6975c0c1fD4b868
